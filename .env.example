# Copy to .env in the project root for source runs, or beside SecurityCenter.exe.
# Existing process/service environment variables always take precedence.
SECURITY_CENTER_HOST=127.0.0.1
SECURITY_CENTER_PORT=8000
SECURITY_CENTER_LOG_LEVEL=INFO
# Comma-separated extra browser origins. Leave empty for loopback-only use.
SECURITY_CENTER_ALLOWED_ORIGINS=

# Optional Qwen3-VL 2B fallback. Defaults use runtime/ and models/ under the project/install root.
SECURITY_CENTER_AI_PORT=8091
SECURITY_CENTER_AI_THREADS=6
# SECURITY_CENTER_AI_RUNTIME=C:\path\to\llama-server.exe
# SECURITY_CENTER_AI_MODEL=C:\path\to\Qwen3VL-2B-Instruct-Q4_K_M.gguf
# SECURITY_CENTER_AI_MMPROJ=C:\path\to\mmproj-Qwen3VL-2B-Instruct-Q8_0.gguf